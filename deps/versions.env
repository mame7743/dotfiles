# deps/versions.env — 固定するツールのバージョンとチェックサム
#
# このファイルが「浮動で入れたくない依存」の唯一の情報源 (single source of truth)。
# install-deps.sh / install-deps.ps1 はここを source して使う。
#
# 通常は手で編集せず `make deps-update` で更新する（最新版の取得 + ロック更新）。
# 秘密値・実 IP・トークンは書かない。
#
# 命名規則:
#   <TOOL>_VERSION                  … バージョン
#   <TOOL>_<OS>_<ARCH>_SHA256       … GitHub リリース資産のチェックサム
#   OS/ARCH は LINUX_AMD64 / LINUX_ARM64 / LINUX_X64
#
# 方針（層ごとの使い分け）は docs/dependency-policy.md を参照。

# ---------------------------------------------------------------------------
# GitHub リリースから取得するツール（Linux のみ。macOS は Homebrew）
# ---------------------------------------------------------------------------
LAZYGIT_VERSION="0.65.1"
LAZYGIT_LINUX_AMD64_SHA256="02beacbcda0fa342e50ae3480ba8147307353af3fb28e1d5f790e02329c201a6"
LAZYGIT_LINUX_ARM64_SHA256="49abecdf6adf4f2dfdb11bf7b9bfada267ea523612ed809d1c6d87f6c04000a7"

LUALS_VERSION="3.19.1"
LUALS_LINUX_X64_SHA256="e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8"
LUALS_LINUX_ARM64_SHA256="abd2572e8fc929dc838a81ffb8473c5bce0bf39bfe8edb4b120b3b623176ce83"

# ---------------------------------------------------------------------------
# `go install` で取得するツール
# ---------------------------------------------------------------------------
GHQ_VERSION="v1.10.1"
GOPLS_VERSION="v0.23.0"
GOLANGCI_LINT_VERSION="v2.13.2"

# ---------------------------------------------------------------------------
# 言語ランタイムはここではなく config/mise/config.toml で固定する
# （二重管理を避けるため versions.env には置かない）
# ---------------------------------------------------------------------------
